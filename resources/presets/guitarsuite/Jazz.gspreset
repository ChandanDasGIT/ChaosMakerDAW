{
  "format": "GuitarSuitePreset",
  "version": 1,
  "name": "Jazz",
  "inputTrimDb": 0,
  "pedals": [
    {
      "type": "pedal.compressor",
      "bypassed": false,
      "parameters": {
        "threshold": -22,
        "ratio": 2,
        "attack": 25,
        "release": 180,
        "makeup": 3
      }
    },
    {
      "type": "pedal.amp",
      "bypassed": false,
      "parameters": {
        "channel": 0,
        "drive": 8,
        "bass": 1,
        "mid": 1,
        "treble": -3,
        "presence": 0.15,
        "resonance": 0.2,
        "master": 0
      }
    },
    {
      "type": "pedal.cabinet",
      "bypassed": false,
      "parameters": {
        "model": 1,
        "mix": 1,
        "level": 0
      }
    },
    {
      "type": "pedal.parametriceq",
      "bypassed": false,
      "parameters": {
        "lowfreq": 150,
        "lowgain": 0,
        "lowq": 0.7,
        "midfreq": 800,
        "midgain": 1,
        "midq": 0.7,
        "highfreq": 3500,
        "highgain": -4,
        "highq": 0.5,
        "level": 0
      }
    },
    {
      "type": "pedal.reverb",
      "bypassed": false,
      "parameters": {
        "room": 0.35,
        "damping": 0.7,
        "mix": 0.14
      }
    }
  ]
}
