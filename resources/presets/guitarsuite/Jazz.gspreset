{
  "format": "GuitarSuitePreset",
  "version": 1,
  "name": "Jazz",
  "inputTrimDb": 0,
  "pedals": [
    {
      "type": "pedal.compressor",
      "bypassed": false,
      "parameters": {
        "threshold": -20,
        "ratio": 1.6,
        "attack": 25,
        "release": 180,
        "makeup": 1.5
      }
    },
    {
      "type": "pedal.amp",
      "bypassed": false,
      "parameters": {
        "drive": 0,
        "bass": 1.5,
        "mid": 2,
        "treble": -4,
        "presence": 0.05,
        "master": -5
      }
    },
    {
      "type": "pedal.cabinet",
      "bypassed": false,
      "parameters": {
        "mix": 1,
        "level": 0
      }
    },
    {
      "type": "pedal.parametriceq",
      "bypassed": false,
      "parameters": {
        "lowfreq": 150,
        "lowgain": -1,
        "lowq": 0.7,
        "midfreq": 900,
        "midgain": 1,
        "midq": 0.7,
        "highfreq": 3500,
        "highgain": -3,
        "highq": 0.5,
        "level": 0
      }
    },
    {
      "type": "pedal.reverb",
      "bypassed": false,
      "parameters": {
        "room": 0.35,
        "damping": 0.65,
        "mix": 0.12
      }
    }
  ]
}
